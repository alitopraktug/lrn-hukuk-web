# nginx ters vekil örneği (Ubuntu/Debian). /etc/nginx/sites-available/lrn-hukuk
# HTTPS sertifikası (Let's Encrypt, otomatik yenilenir):  sudo certbot --nginx -d alanadi.com -d www.alanadi.com
# ÖNEMLİ: X-Forwarded-For başlığı $remote_addr ile ÜZERİNE YAZILIR (istemcinin gönderdiği değer güvenilmez);
# hız sınırları ve denetim kayıtları gerçek IP'ye bu sayede dayanır.

server {
    listen 80;
    server_name alanadi.com www.alanadi.com;
    return 301 https://alanadi.com$request_uri;          # HTTP → HTTPS
}

server {
    listen 443 ssl http2;
    server_name www.alanadi.com;
    # ssl_certificate / ssl_certificate_key satırlarını certbot ekler
    return 301 https://alanadi.com$request_uri;          # www → kanonik alan adı
}

server {
    listen 443 ssl http2;
    server_name alanadi.com;
    # ssl_certificate / ssl_certificate_key satırlarını certbot ekler

    client_max_body_size 10m;                            # görsel yüklemeleri (uygulama 8 MB ile sınırlar)
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;   # üzerine yaz — ekleme (append) YAPMA
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }
}
