# ─────────────────────────────────────────────────────────────────────────────
# LRN Hukuk — ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayın (yerelde) ya da aynı değişkenleri hosting
# sağlayıcınızın "Environment Variables" bölümüne girin (üretimde).
# GERÇEK DEĞERLERİ ASLA GİT DEPOSUNA YÜKLEMEYİN. `.env` dosyası .gitignore içindedir.
# ─────────────────────────────────────────────────────────────────────────────

# ── Zorunlu ──────────────────────────────────────────────────────────────────

# PostgreSQL bağlantı adresi.
#  Yerel geliştirme (npm run db:dev):  postgresql://lrn:lrn@localhost:5432/lrn_hukuk
#  Yönetilen servis (Neon, Supabase, Railway, Render, Hetzner…): sağlayıcının verdiği adres
#  (sunucusuz ortamlarda "pooled / pgbouncer" adresi önerilir; gerekirse sonuna ?sslmode=require ekleyin)
DATABASE_URL=

# Oturum ve şifreleme sırlarının türetildiği anahtar. En az 32 karakter, rastgele:
#   openssl rand -base64 48
# DİKKAT: Değiştirirseniz açık oturumlar geçersiz olur ve kayıtlı 2FA sırları çözülemez
# (kullanıcıların 2FA'sını panelden sıfırlamanız gerekir). Üretimde bir kez belirleyip saklayın.
AUTH_SECRET=

# Sitenin kanonik adresi (https://, sonunda / olmadan). Canonical, sitemap, OG, çerez güvenliği ve
# HSTS bu değere bakar. Alan adı henüz yoksa geçici adresi yazın, alan adı bağlanınca güncelleyin.
# DİKKAT: NEXT_PUBLIC_* değişkenleri DERLEME sırasında koda gömülür; değiştirince uygulamayı yeniden derleyin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── E-posta (SMTP) — iletişim formu bildirimleri ve parola sıfırlama ────────
# Herhangi bir SMTP sağlayıcısı olur (Google Workspace, Microsoft 365, hosting e-postası, Brevo, Mailgun…).
# SMTP tanımlı değilse site yine çalışır; iletişim mesajları yalnızca panelde (veritabanında) görünür.
SMTP_HOST=
SMTP_PORT=587            # 465 → SSL/TLS, 587 → STARTTLS
SMTP_USER=
SMTP_PASSWORD=
# Mesajların gönderileceği yetkili adres (panelde "Site Ayarları"ndan da verilebilir)
CONTACT_TO_EMAIL=
# Gönderen adres — alan adınıza ait olmalıdır (SPF/DKIM/DMARC için); ör. iletisim@alanadi.com
CONTACT_FROM_EMAIL=

# ── Analitik ve arama motoru (isteğe bağlı) ──────────────────────────────────
# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX). Boşsa hiçbir izleme kodu yüklenmez ve çerez banner'ı gösterilmez.
# Ayrıca panelden (Site Ayarları) girilebilir; panelde girilen değer önceliklidir.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML etiketi" doğrulama kodu (content değeri). Panelde SEO sayfasından da girilebilir.
GOOGLE_SITE_VERIFICATION=

# ── Harita (isteğe bağlı) ────────────────────────────────────────────────────
# Google Haritalar "yerleştir (embed)" iframe adresi (API anahtarı GEREKTİRMEZ) veya OpenStreetMap embed adresi.
# Panelde Site Ayarları'ndan da girilebilir. Harita, ziyaretçi "Haritayı yükle"ye basana kadar yüklenmez.
NEXT_PUBLIC_MAP_EMBED_URL=

# ── Bot koruması (isteğe bağlı) — Cloudflare Turnstile ───────────────────────
# İkisi de tanımlıysa iletişim formunda Turnstile doğrulaması zorunlu olur (honeypot + hız sınırı zaten vardır).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Bakım rotası (isteğe bağlı) ──────────────────────────────────────────────
# /api/cron/maintenance için gizli anahtar (Vercel Cron bunu otomatik "Authorization: Bearer …" olarak gönderir).
# Tanımlı değilse rota kapalıdır. Sunucuda `npm run maintenance` (cron) da kullanılabilir.
CRON_SECRET=

# ── Gelişmiş / dağıtım ───────────────────────────────────────────────────────
# Alan adı vekil (proxy) arkasında farklıysa Server Action'lar için izinli kaynaklar (virgülle ayırın)
# ALLOWED_ORIGINS=www.alanadi.com,alanadi.com
# true → istekler NEXT_PUBLIC_SITE_URL'deki alan adına 308 ile yönlendirilir (www / www'siz tekilleştirme)
# ENFORCE_CANONICAL_HOST=false
# Veritabanı bağlantı havuzu üst sınırı (sunucusuz ortamlarda küçük tutun)
# DATABASE_POOL_MAX=8
# Docker için "standalone" çıktı: NEXT_OUTPUT=standalone npm run build
# NEXT_OUTPUT=

# ── Medya depolama ───────────────────────────────────────────────────────────
# Yüklenen görseller varsayılan olarak PostgreSQL'de (MediaBlob tablosu) saklanır → tek yedekleme noktası, ek servis ve
# maliyet yok, sağlayıcıya bağımlılık yok. Depolama katmanı lib/media/storage.ts içindedir; medya çok büyürse
# (binlerce görsel) aynı arayüzün arkasına S3 uyumlu bir sürücü eklenebilir. Şimdilik ek değişken gerekmez.

# ── Docker Compose (yalnızca docker-compose.yml kullanıyorsanız) ─────────────
# Konteynerdeki PostgreSQL için parola (DATABASE_URL compose içinde bu parolayla otomatik kurulur)
# POSTGRES_PASSWORD=
